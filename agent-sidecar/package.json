{
  "name": "agent-sidecar",
  "version": "1.0.0",
  "description": "Headless Node.js agent runner using Pi SDK for Axiom",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsup src/server.ts --format cjs,esm --dts",
    "start": "node dist/server.js",
    "postinstall": "rm -rf node_modules/@earendil-works/pi-coding-agent/node_modules/undici"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.79.10",
    "@earendil-works/pi-ai": "^0.79.10",
    "@earendil-works/pi-coding-agent": "^0.79.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pi-mcp-extension": "^1.5.0",
    "undici": "6.21.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2"
  },
  "overrides": {
    "undici": "6.21.1"
  }
}
