{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom-IDE",
  "version": "0.1.1_developer-preview",
  "identifier": "com.suciuvictortraian.axiom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Axiom IDE",
        "width": 800,
        "height": 600,
        "maximized": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["bin/node"],
    "resources": ["resources/sidecar"]
  }
}
