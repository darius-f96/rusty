{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "node",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}